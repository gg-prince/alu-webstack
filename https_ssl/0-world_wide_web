#!/usr/bin/env bash
# Displays information about the subdomains of a domain
# shellcheck disable=SC2086
ggp_display_info () {
  local ggp_sub="$2"
  dig "$ggp_sub.$1" | grep -A1 'ANSWER SECTION:' | tail -n 1 | awk -v ggp_sub="$ggp_sub" '{print "The subdomain " ggp_sub " is a " $4 " record and points to " $5}'
}

if [ -n "$2" ]
then
  ggp_display_info "$1" "$2"
else
  for ggp_s in www lb-01 web-01 web-02
  do
    ggp_display_info "$1" "$ggp_s"
  done
fi
