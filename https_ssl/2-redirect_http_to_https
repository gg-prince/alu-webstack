global
    log /dev/log local0
    chroot /var/lib/haproxy
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option forwardfor
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend ggp_http_front
    bind *:80
    bind *:443 ssl crt /etc/haproxy/certs/www.ggptrial.ooguy.com.pem
    http-request set-header X-Forwarded-Proto https if { ssl_fc }
    redirect scheme https code 301 if !{ ssl_fc }
    default_backend ggp_webservers

backend ggp_webservers
    balance roundrobin
    server web-01 18.170.32.219:80 check
    server web-02 18.170.99.250:80 check
